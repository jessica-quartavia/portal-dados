---
// TEMPLATE de dashboard — copie para src/pages/dashboards/<slug>.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import KpiCard from "../../components/KpiCard.astro";
// import MeuGrafico from "../../components/MeuGrafico.tsx";

const titulo = "Novo Dashboard";
---

<BaseLayout title={titulo} subtitle="Descrição curta do painel">

  <!-- Título da página -->
  <div style="margin-bottom: var(--space-6)">
    <h1 style="font-size: var(--fs-2xl); font-weight: var(--fw-bold); letter-spacing: -0.02em; margin: 0 0 var(--space-2)">
      {titulo}
    </h1>
    <p style="color: var(--color-text-muted); font-size: var(--fs-sm); margin: 0">
      Subtítulo ou contexto do painel
    </p>
  </div>

  <!-- 1) Linha de KPIs (colunas de 3) -->
  <div class="qv-grid" style="margin-bottom: var(--space-5)">
    <div class="qv-col-3"><KpiCard label="Indicador A" value="0" highlight /></div>
    <div class="qv-col-3"><KpiCard label="Indicador B" value="0" trend="0%" direction="up" /></div>
    <div class="qv-col-3"><KpiCard label="Indicador C" value="0" trend="0%" direction="down" /></div>
    <div class="qv-col-3"><KpiCard label="Indicador D" value="0" /></div>
  </div>

  <!-- 2) Conteúdo principal -->
  <div class="qv-grid">
    <div class="qv-col-6 qv-card">
      <h2 class="qv-section-title">Gráfico</h2>
      <!-- <MeuGrafico client:load /> -->
      <p style="color: var(--color-text-muted); font-size: var(--fs-sm)">
        Adicione aqui sua ilha de gráfico (client:load).
      </p>
    </div>

    <div class="qv-col-6 qv-card">
      <h2 class="qv-section-title">Tabela</h2>
      <table class="qv-table">
        <thead>
          <tr>
            <th>Coluna</th>
            <th style="text-align:right">Valor</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Exemplo</td>
            <td style="text-align:right">—</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

</BaseLayout>
