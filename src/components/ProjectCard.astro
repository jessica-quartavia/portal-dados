---
import LayoutDashboard from "@lucide/astro/icons/layout-dashboard";
import ChartNoAxesCombined from "@lucide/astro/icons/chart-no-axes-combined";
import BookOpen from "@lucide/astro/icons/book-open";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ExternalLink from "@lucide/astro/icons/external-link";
import type { PortalProject } from "../data/portal";

interface Props {
  project: PortalProject;
}

const { project } = Astro.props;
const { title, category, description, href, external, icon, cta, meta } = project;
---

<a
  class="project-card"
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <div class="project-card__icon" aria-hidden="true">
    {icon === "layout-dashboard" && <LayoutDashboard size={28} stroke-width={1.75} />}
    {icon === "chart-no-axes-combined" && <ChartNoAxesCombined size={28} stroke-width={1.75} />}
    {icon === "book-open" && <BookOpen size={28} stroke-width={1.75} />}
  </div>

  <p class="project-card__category">{category}</p>
  <h2 class="project-card__title">{title}</h2>
  {meta && <p class="project-card__meta">{meta}</p>}
  <p class="project-card__desc">{description}</p>

  <span class="project-card__cta">
    {cta}
    {external ? (
      <ExternalLink size={14} stroke-width={2} aria-hidden="true" />
    ) : (
      <ArrowRight size={14} stroke-width={2} aria-hidden="true" />
    )}
  </span>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 292px;
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--color-text);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .project-card:hover {
    border-color: var(--color-border-strong);
    background: var(--color-surface-2);
    box-shadow: var(--shadow-card);
    transform: translateY(-3px);
    text-decoration: none;
  }

  .project-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .project-card__icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-5);
    border-radius: var(--radius-md);
    background: var(--color-primary-tint);
    color: var(--color-primary);
    border: 1px solid var(--color-primary-tint);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .project-card:hover .project-card__icon {
    border-color: var(--color-primary);
    transform: translateY(-1px);
  }

  .project-card__category {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .project-card__title {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.02em;
    line-height: var(--lh-tight);
    color: var(--color-text);
  }

  .project-card__meta {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    color: var(--color-text-subtle);
  }

  .project-card__desc {
    margin: 0 0 var(--space-5);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    line-height: var(--lh-relaxed);
    flex: 1;
  }

  .project-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--color-primary);
    transition: gap 0.2s ease, color 0.2s ease;
  }

  .project-card:hover .project-card__cta {
    gap: var(--space-3);
    color: var(--color-primary-hover);
  }

  @media (max-width: 640px) {
    .project-card {
      min-height: 0;
      padding: var(--space-5);
    }

    .project-card__icon {
      width: 48px;
      height: 48px;
      margin-bottom: var(--space-4);
    }
  }
</style>
