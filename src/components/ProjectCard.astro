---
import LayoutDashboard from "@lucide/astro/icons/layout-dashboard";
import ChartNoAxesCombined from "@lucide/astro/icons/chart-no-axes-combined";
import BookOpen from "@lucide/astro/icons/book-open";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ExternalLink from "@lucide/astro/icons/external-link";
import type { PortalProject } from "../data/portal";

interface Props {
  project: PortalProject;
}

const { project } = Astro.props;
const { title, category, description, href, external, icon, cta, meta, featured, statusBadge } = project;
const isImageIcon = icon.type === "image";
---

<a
  class:list={["project-card", featured && "project-card--featured"]}
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <div class="project-card__body">
    <div class="project-card__top">
      <div
        class:list={[
          "project-card__icon",
          isImageIcon && "project-card__icon--image",
          featured && isImageIcon && "project-card__icon--image-featured",
        ]}
        aria-hidden="true"
      >
        {icon.type === "image" ? (
          <img
            class="project-card__icon-img"
            src={icon.src}
            alt=""
            width="32"
            height="32"
            loading="lazy"
            decoding="async"
          />
        ) : icon.name === "layout-dashboard" ? (
          <LayoutDashboard size={20} stroke-width={1.75} />
        ) : icon.name === "chart-no-axes-combined" ? (
          <ChartNoAxesCombined size={20} stroke-width={1.75} />
        ) : (
          <BookOpen size={20} stroke-width={1.75} />
        )}
      </div>
      <div class="project-card__badges">
        {statusBadge && <span class="project-card__status">{statusBadge}</span>}
        {featured && <span class="project-card__badge">Principal</span>}
      </div>
    </div>

    <p class="project-card__category">{category}</p>
    <h2 class="project-card__title">{title}</h2>
    {meta && <p class="project-card__meta">{meta}</p>}
    <p class="project-card__desc">{description}</p>

    <span class="project-card__cta">
      {cta}
      {external ? (
        <ExternalLink size={14} stroke-width={2} aria-hidden="true" />
      ) : (
        <ArrowRight size={14} stroke-width={2} aria-hidden="true" />
      )}
    </span>
  </div>

  {featured && (
    <div class="project-card__preview" aria-hidden="true">
      <div class="preview-panel">
        <span class="preview-bar" style="width: 72%"></span>
        <span class="preview-bar" style="width: 46%"></span>
        <span class="preview-bar preview-bar--accent" style="width: 88%"></span>
        <span class="preview-bar" style="width: 58%"></span>
        <span class="preview-bar" style="width: 34%"></span>
      </div>
    </div>
  )}
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    text-decoration: none;
    color: var(--color-text);
    cursor: pointer;
    overflow: hidden;
    transition:
      border-color 0.18s ease,
      background-color 0.18s ease,
      transform 0.18s ease;
  }

  .project-card--featured {
    padding: 0;
  }

  .project-card:hover {
    border-color: var(--color-border-strong);
    background: var(--color-surface);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .project-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .project-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    padding: 0;
  }

  .project-card--featured .project-card__body {
    padding: var(--space-6);
  }

  .project-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .project-card__icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: var(--color-surface-2);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .project-card--featured .project-card__icon:not(.project-card__icon--image) {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    color: var(--color-primary);
    background: var(--color-primary-tint);
    border-color: transparent;
  }

  .project-card__icon--image {
    padding: 5px;
    background: var(--color-surface-2);
    border-color: var(--color-border);
    overflow: hidden;
  }

  .project-card__icon--image-featured {
    width: 48px;
    height: 48px;
    padding: 6px;
    border-radius: 12px;
    background: var(--color-surface-2);
    border-color: var(--color-border);
  }

  .project-card__icon-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    border-radius: 4px;
  }

  .project-card__badges {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .project-card__badge {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: var(--color-primary-tint);
    padding: 4px 9px;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .project-card__status {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    padding: 4px 9px;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .project-card__category {
    margin: 0 0 6px;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .project-card__title {
    margin: 0 0 var(--space-2);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.25;
    color: var(--color-text);
  }

  .project-card--featured .project-card__title {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
  }

  .project-card__meta {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--color-text-subtle);
  }

  .project-card__desc {
    margin: 0 0 var(--space-5);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    flex: 1;
  }

  .project-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-text);
    transition: color 0.15s ease, gap 0.15s ease;
  }

  .project-card:hover .project-card__cta {
    color: var(--color-primary);
    gap: 10px;
  }

  .project-card__preview {
    display: none;
    background: var(--color-surface-2);
    border-left: 1px solid var(--color-border);
    min-height: 100%;
  }

  .preview-panel {
    height: 100%;
    min-height: 168px;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
  }

  .preview-bar {
    display: block;
    height: 8px;
    border-radius: 999px;
    background: var(--color-border-strong);
    opacity: 0.7;
  }

  .preview-bar--accent {
    background: var(--color-primary);
    opacity: 0.85;
  }

  @media (min-width: 960px) {
    .project-card--featured {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(220px, 0.7fr);
      align-items: stretch;
    }

    .project-card__preview {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .project-card,
    .project-card--featured .project-card__body {
      padding: var(--space-5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card:hover {
      transform: none;
    }
  }
</style>
