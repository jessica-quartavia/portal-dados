---
// Card de abertura de ticket para o time de Dados.
interface Props {
  href: string;
  badge?: string;
  title?: string;
  description?: string;
  cta?: string;
}

const {
  href,
  badge = "Ticket — Time de Dados",
  title = "Solicitar apoio do time de Dados",
  description = "Abra um ticket para solicitar novos dashboards, ajustes em indicadores, correções de dados ou automações relacionadas à área de Dados.",
  cta = "Abrir ticket no Jira",
} = Astro.props;
---

<div class="stc">
  <div class="stc__left">
    <span class="stc__badge">
      <!-- Ícone de ticket inline -->
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M1 4.5a1.5 1.5 0 0 1 0-3h10a1.5 1.5 0 0 1 0 3M1 4.5v3M11 4.5v3M1 7.5a1.5 1.5 0 0 0 0 3h10a1.5 1.5 0 0 0 0-3M5 6h2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      </svg>
      {badge}
    </span>
    <h2 class="stc__title">{title}</h2>
    <p class="stc__desc">{description}</p>
  </div>

  <div class="stc__right">
    <a
      class="stc__btn"
      href={href}
      target="_blank"
      rel="noopener noreferrer"
    >
      {cta}
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M5 2.5h6.5V9M11.5 2.5l-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</div>

<style>
  .stc {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    background: var(--color-surface);
    background-image: var(--gradient-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
    box-shadow: var(--shadow-card);
    position: relative;
    overflow: hidden;
  }

  /* Glow laranja discreto no canto esquerdo */
  .stc::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--gradient-primary);
    border-radius: var(--radius-lg) 0 0 var(--radius-lg);
  }

  .stc__left {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
    min-width: 0;
  }

  .stc__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    color: var(--color-primary);
    background: var(--color-primary-tint);
    padding: 3px 10px;
    border-radius: var(--radius-full);
    align-self: flex-start;
    letter-spacing: 0.03em;
  }

  .stc__title {
    font-size: var(--fs-base);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .stc__desc {
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    margin: 0;
    line-height: var(--lh-relaxed);
    max-width: 580px;
  }

  .stc__right {
    flex-shrink: 0;
  }

  .stc__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--gradient-primary);
    color: var(--color-text-on-primary);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    padding: 0 var(--space-5);
    height: 40px;
    border-radius: var(--radius-md);
    text-decoration: none;
    box-shadow: var(--shadow-btn-primary);
    transition: box-shadow 0.15s ease, transform 0.1s ease;
    white-space: nowrap;
    letter-spacing: 0.01em;
  }
  .stc__btn:hover {
    box-shadow: var(--shadow-btn-primary-hover);
    transform: translateY(-1px);
    text-decoration: none;
  }
  .stc__btn:active {
    transform: translateY(0);
  }

  @media (max-width: 640px) {
    .stc {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
      padding: var(--space-5);
    }
    .stc__right { width: 100%; }
    .stc__btn { width: 100%; justify-content: center; }
  }
</style>
