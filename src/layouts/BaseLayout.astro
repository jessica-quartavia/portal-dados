---
// Layout base — aplica o design system (theme.css + Inter) em todas as páginas.
import "../../packages/design-system/theme.css";

interface Props {
  title?: string;
  subtitle?: string;
}
const { title = "Grupo Quarta Via", subtitle } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title} · Quarta Via</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="qv-header">
      <div class="qv-header__brand">
        <span class="qv-logo" aria-hidden="true">QV</span>
        <div>
          <strong>Grupo Quarta Via</strong>
          {subtitle && <span class="qv-header__subtitle">{subtitle}</span>}
        </div>
      </div>
      <a class="qv-btn qv-btn--ghost" href="/">← Portal</a>
    </header>

    <main class="qv-main">
      <slot />
    </main>

    <style>
      .qv-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--space-4) var(--space-6);
        border-bottom: 1px solid var(--color-border);
        background: var(--color-surface);
      }
      .qv-header__brand {
        display: flex;
        align-items: center;
        gap: var(--space-3);
      }
      .qv-header__subtitle {
        display: block;
        font-size: var(--fs-sm);
        color: var(--color-text-muted);
      }
      .qv-logo {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: var(--radius-md);
        background: var(--color-primary);
        color: var(--color-text-on-primary);
        font-weight: var(--fw-bold);
        font-size: var(--fs-sm);
      }
      .qv-main {
        max-width: 1280px;
        margin: 0 auto;
        padding: var(--space-6);
      }
    </style>
  </body>
</html>
