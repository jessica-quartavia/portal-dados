---
import "../../packages/design-system/theme.css";
import ThemeInit from "../components/ThemeInit.astro";
import PortalHeader from "../components/PortalHeader.astro";
import AccessCover from "../components/AccessCover";

interface Props {
  title?: string;
  subtitle?: string;
}

const { title = "Analytics QuartaVia" } = Astro.props;
const documentTitle =
  title === "Analytics QuartaVia" ? title : `${title} · Analytics QuartaVia`;
---

<!doctype html>
<html lang="pt-BR" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>{documentTitle}</title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <ThemeInit />
  </head>
  <body>
    <AccessCover client:load />
    <PortalHeader showPortal={true} showLogout={false} />

    <main class="qv-main">
      <slot />
    </main>
  </body>
</html>

<style>
  .qv-main {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-6) 40px;
  }

  @media (max-width: 1024px) {
    .qv-main {
      padding: var(--space-5) var(--space-6);
    }
  }

  @media (max-width: 640px) {
    .qv-main {
      padding: var(--space-4);
    }
  }
</style>
