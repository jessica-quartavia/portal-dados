---
/**
 * Callback OAuth Google via Supabase Auth.
 */
export const prerender = false;

import { createAuthServerClient } from '../../lib/supabase-server';
import { isAllowedEmail } from '../../lib/auth';

const isDev = import.meta.env.DEV;

try {
  const code       = Astro.url.searchParams.get('code');
  const oauthError = Astro.url.searchParams.get('error');

  if (oauthError) {
    if (isDev) console.error('[callback] OAuth error from provider:', oauthError);
    return Astro.redirect('/login?error=auth_failed');
  }

  if (!code) {
    if (isDev) console.error('[callback] No code in URL');
    return Astro.redirect('/login?error=missing_code');
  }

  const supabase = createAuthServerClient(Astro.request, Astro.cookies);
  if (!supabase) {
    return Astro.redirect('/login?error=auth_config');
  }

  const { data, error: exchangeError } = await supabase.auth.exchangeCodeForSession(code);

  if (exchangeError) {
    if (isDev) console.error('[callback] exchangeCodeForSession failed:', exchangeError);
    return Astro.redirect('/login?error=exchange_failed');
  }

  if (!data.session) {
    if (isDev) console.error('[callback] session missing after exchange');
    return Astro.redirect('/login?error=session_missing');
  }

  const email = data.session.user?.email ?? '';
  if (!isAllowedEmail(email)) {
    try {
      await supabase.auth.signOut();
    } catch {
      // ignore
    }
    return Astro.redirect('/login?error=unauthorized_domain');
  }

  return Astro.redirect('/');
} catch (error) {
  console.error('[callback] falha inesperada:', error);
  return Astro.redirect('/login?error=auth_failed');
}
---
