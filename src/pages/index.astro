---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getPortalProjects } from "../data/portal";

const projects = getPortalProjects();
---

<BaseLayout title="Analytics QuartaVia" showPortal={false}>

  <div class="portal-hero">
    <div class="portal-hero__content">
      <p class="portal-hero__eyebrow">Inteligência QuartaVia</p>
      <h1 class="portal-hero__title">Analytics QuartaVia</h1>
      <p class="portal-hero__desc">
        Portal central dos projetos, sistemas e análises desenvolvidos pelo time de Inteligência da QuartaVia.
      </p>
      <p class="portal-hero__lead">
        Acesse dashboards, ferramentas e soluções de dados em um único lugar.
      </p>
    </div>
  </div>

  <section class="portal-projects" aria-label="Projetos do time de Inteligência">
    {projects.map((project) => (
      <ProjectCard project={project} />
    ))}
  </section>

</BaseLayout>

<style>
  .portal-hero {
    background: var(--gradient-hero);
    padding: var(--space-7) 0 var(--space-6);
    margin-bottom: var(--space-6);
  }

  .portal-hero__eyebrow {
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 var(--space-2);
  }

  .portal-hero__title {
    font-size: var(--fs-2xl);
    font-weight: var(--fw-bold);
    margin: 0 0 var(--space-3);
    letter-spacing: -0.02em;
    line-height: var(--lh-tight);
    color: var(--color-text);
  }

  .portal-hero__desc {
    color: var(--color-text-muted);
    margin: 0 0 var(--space-3);
    font-size: var(--fs-base);
    max-width: 640px;
    line-height: var(--lh-relaxed);
  }

  .portal-hero__lead {
    color: var(--color-text-subtle);
    margin: 0;
    font-size: var(--fs-sm);
    max-width: 560px;
    line-height: var(--lh-relaxed);
  }

  .portal-projects {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    align-items: stretch;
  }

  @media (min-width: 768px) {
    .portal-projects {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .portal-projects {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .portal-hero {
      padding: var(--space-5) 0 var(--space-5);
      margin-bottom: var(--space-5);
    }
  }
</style>
