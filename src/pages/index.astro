---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getPortalProjects } from "../data/portal";

const projects = getPortalProjects();
const featured = projects.find((project) => project.featured) ?? projects[0];
const catalog = projects.filter((project) => project.slug !== featured.slug);
---

<BaseLayout title="Analytics QuartaVia" showPortal={false}>

  <section class="portal-hero" aria-labelledby="portal-title">
    <p class="eyebrow">Inteligência QuartaVia</p>
    <h1 id="portal-title">Analytics QuartaVia</h1>
    <p class="portal-hero__lead">
      Central de produtos, dashboards e análises do time de Inteligência.
    </p>
  </section>

  <section class="portal-featured" aria-labelledby="featured-heading">
    <h2 id="featured-heading" class="visually-hidden">Produto principal</h2>
    <ProjectCard project={featured} />
  </section>

  <section class="portal-catalog" aria-labelledby="catalog-heading">
    <div class="portal-catalog__intro">
      <h2 id="catalog-heading">Produtos e ferramentas</h2>
      <p class="note-muted">Sistemas e bases de análise da QuartaVia.</p>
    </div>

    <div class="portal-catalog__grid">
      {catalog.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

</BaseLayout>

<style>
  .eyebrow {
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: var(--fw-semibold);
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin: 0 0 var(--space-3);
  }

  .portal-hero {
    padding: var(--space-5) 0 var(--space-6);
    background: none;
  }

  .portal-hero h1 {
    margin: 0 0 var(--space-3);
    max-width: 18ch;
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: var(--color-text);
  }

  .portal-hero__lead,
  .note-muted {
    margin: 0;
    max-width: 36rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .portal-featured {
    margin-bottom: var(--space-7);
  }

  .portal-catalog__intro {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
  }

  .portal-catalog__intro h2 {
    margin: 0;
    font-size: var(--fs-lg);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .portal-catalog__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    align-items: stretch;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 768px) {
    .portal-catalog__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .portal-catalog__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .portal-hero {
      padding: var(--space-4) 0 var(--space-5);
    }

    .portal-hero h1 {
      max-width: none;
    }

    .portal-featured {
      margin-bottom: var(--space-6);
    }
  }
</style>
