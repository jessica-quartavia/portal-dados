---
import "../../packages/design-system/theme.css";
import ThemeInit from "../components/ThemeInit.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import LoginWithGoogle from "../components/LoginWithGoogle";
import { createAuthServerClient } from '../lib/supabase-server';
import { isAllowedEmail } from '../lib/auth';

let alreadySignedIn = false;
try {
  const supabase = createAuthServerClient(Astro.request, Astro.cookies);
  if (supabase) {
    const { data: { session } } = await supabase.auth.getSession();
    alreadySignedIn = Boolean(session && isAllowedEmail(session.user.email));
  }
} catch (error) {
  console.error('[login] falha ao verificar sessão:', error);
}
if (alreadySignedIn) {
  return Astro.redirect('/');
}

const errorParam = Astro.url.searchParams.get('error');
const ERROR_MESSAGES: Record<string, string> = {
  unauthorized_domain: 'Acesso restrito a contas corporativas @quartavia.com.br.',
  missing_code:        'Callback OAuth sem código de autorização.',
  auth_failed:         'Falha na autenticação com o Google. Tente novamente.',
  exchange_failed:     'Falha ao concluir login com Google. Tente novamente.',
  session_missing:     'Sessão não encontrada após autenticação. Tente novamente.',
  auth_config:         'Autenticação indisponível. Verifique as variáveis PUBLIC_AUTH_SUPABASE_* na hospedagem.',
};
const errorMessage = errorParam ? (ERROR_MESSAGES[errorParam] ?? `Erro de autenticação: ${errorParam}`) : '';
---

<!doctype html>
<html lang="pt-BR" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>Acesso · Analytics QuartaVia</title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <ThemeInit />
  </head>
  <body class="login-body">
    <div class="login-toolbar">
      <ThemeToggle />
    </div>

    <main class="login-main">
      <div class="login-card">
        <div class="login-brand">
          <img class="login-logo-img" src="/favicon.ico" alt="" width="40" height="40" />
          <div class="login-brand-text">
            <span class="login-brand-name">Analytics QuartaVia</span>
            <span class="login-brand-sub">Inteligência</span>
          </div>
        </div>

        <div class="login-heading">
          <p class="eyebrow">Acesso interno</p>
          <h1 class="login-title">Entre no portal</h1>
          <p class="login-subtitle">
            Use a conta Google corporativa da QuartaVia.
          </p>
        </div>

        {errorMessage && (
          <div class="login-error" role="alert">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.5"/>
              <path d="M7 4v3.5M7 9.5v.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            {errorMessage}
          </div>
        )}

        <LoginWithGoogle client:load />

        <p class="login-hint">
          Acesso restrito a contas <strong>@quartavia.com.br</strong>
        </p>
      </div>
    </main>
  </body>
</html>

<style>
  .login-body {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bg);
    background-image: none;
  }

  .login-toolbar {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
  }

  .login-main {
    width: 100%;
    padding: var(--space-5);
    display: flex;
    justify-content: center;
  }

  .login-card {
    width: 100%;
    max-width: 400px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: var(--space-7) var(--space-6);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .login-brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .login-logo-img {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    object-fit: contain;
    display: block;
    flex-shrink: 0;
  }

  .login-brand-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .login-brand-name {
    font-family: var(--font-heading);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-text);
  }

  .login-brand-sub {
    font-size: var(--fs-xs);
    color: var(--color-text-subtle);
  }

  .eyebrow {
    font-family: var(--font-heading);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 var(--space-2);
  }

  .login-heading {
    display: flex;
    flex-direction: column;
  }

  .login-title {
    font-size: var(--fs-xl);
    font-weight: var(--fw-medium);
    margin: 0 0 var(--space-2);
    letter-spacing: -0.02em;
    color: var(--color-text);
    line-height: var(--lh-tight);
  }

  .login-subtitle {
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    margin: 0;
    line-height: var(--lh-relaxed);
  }

  .login-error {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-danger-soft);
    color: var(--color-danger);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
  }

  .login-error svg {
    flex-shrink: 0;
  }

  .login-hint {
    font-size: var(--fs-xs);
    color: var(--color-text-subtle);
    text-align: center;
    margin: 0;
  }

  .login-hint strong {
    color: var(--color-text-muted);
    font-weight: var(--fw-medium);
  }
</style>
