{
  "$meta": {
    "name": "Analytics QuartaVia — Design Tokens",
    "version": "2.0.0",
    "description": "Fonte única da verdade do design system. theme.css e tailwind.preset.js derivam destes valores. Não duplique cores em outro lugar.",
    "theme": "dark-default-with-light"
  },
  "color": {
    "brand": {
      "primary": "#E85D3A",
      "primaryHover": "#D14E2E",
      "primaryActive": "#B84226",
      "primarySoft": "#F3B5A4",
      "primaryTint": "rgba(232, 93, 58, 0.12)"
    },
    "dark": {
      "background": {
        "base": "#141311",
        "surface": "#1C1B18",
        "surface2": "#252320",
        "overlay": "rgba(12, 11, 9, 0.64)"
      },
      "border": {
        "default": "#2F2C28",
        "strong": "#403C36",
        "focus": "#E85D3A"
      },
      "text": {
        "primary": "#F5F2ED",
        "muted": "#B5AEA4",
        "subtle": "#81786E",
        "onPrimary": "#FFFFFF",
        "link": "#E85D3A"
      }
    },
    "light": {
      "background": {
        "base": "#FAF8F5",
        "surface": "#FFFFFF",
        "surface2": "#F3F0EA",
        "overlay": "rgba(10, 10, 10, 0.4)"
      },
      "border": {
        "default": "#E5E5E5",
        "strong": "#D4D0C8",
        "focus": "#E85D3A"
      },
      "text": {
        "primary": "#0A0A0A",
        "muted": "#525252",
        "subtle": "#737373",
        "onPrimary": "#FFFFFF",
        "link": "#E85D3A"
      }
    },
    "semantic": {
      "success": "#22A45A",
      "warning": "#D18426",
      "danger": "#EA6C4C",
      "info": "#3B82F6",
      "successSoft": "rgba(34, 164, 90, 0.14)",
      "warningSoft": "rgba(209, 132, 38, 0.14)",
      "dangerSoft": "rgba(234, 108, 76, 0.14)",
      "infoSoft": "rgba(59, 130, 246, 0.14)"
    },
    "chart": {
      "categorical": [
        "#E85D3A",
        "#F3B5A4",
        "#8AB4F8",
        "#22A45A",
        "#C792EA",
        "#56D4DD",
        "#EA6C4C",
        "#D18426"
      ],
      "sequential": [
        "#3A1610",
        "#7A2E1C",
        "#B84226",
        "#E85D3A",
        "#F3B5A4",
        "#F8D5CC"
      ],
      "grid": "#2F2C28",
      "axis": "#81786E",
      "tooltipBg": "#252320"
    }
  },
  "font": {
    "family": {
      "heading": "'Ubuntu', system-ui, -apple-system, 'Segoe UI', sans-serif",
      "body": "'Carme', Georgia, 'Times New Roman', serif",
      "sans": "'Carme', Georgia, 'Times New Roman', serif",
      "mono": "'SFMono-Regular', 'SF Mono', Menlo, Consolas, monospace"
    },
    "size": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "24px",
      "2xl": "32px",
      "kpi": "40px"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.7
    }
  },
  "space": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px"
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.4)",
    "md": "0 4px 12px rgba(0, 0, 0, 0.5)",
    "lg": "0 12px 32px rgba(0, 0, 0, 0.6)"
  },
  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  }
}
