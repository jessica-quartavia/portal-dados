{
  "$meta": {
    "name": "Grupo Quarta Via — Design Tokens",
    "version": "1.0.0",
    "description": "Fonte única da verdade do design system. theme.css e tailwind.preset.js derivam destes valores. Não duplique cores em outro lugar.",
    "theme": "dark-first"
  },
  "color": {
    "brand": {
      "primary": "#F47920",
      "primaryHover": "#D8661A",
      "primaryActive": "#BF5613",
      "primarySoft": "#FFB066",
      "primaryTint": "rgba(244, 121, 32, 0.12)"
    },
    "background": {
      "base": "#0D0D0D",
      "surface": "#1A1A1A",
      "surface2": "#222222",
      "overlay": "rgba(0, 0, 0, 0.6)"
    },
    "border": {
      "default": "#2A2A2A",
      "strong": "#3A3A3A",
      "focus": "#F47920"
    },
    "text": {
      "primary": "#FFFFFF",
      "muted": "#B3B3B3",
      "subtle": "#7A7A7A",
      "onPrimary": "#0D0D0D",
      "link": "#F47920"
    },
    "semantic": {
      "success": "#3FB950",
      "warning": "#F5A623",
      "danger": "#E5484D",
      "info": "#3B82F6",
      "successSoft": "rgba(63, 185, 80, 0.14)",
      "warningSoft": "rgba(245, 166, 35, 0.14)",
      "dangerSoft": "rgba(229, 72, 77, 0.14)",
      "infoSoft": "rgba(59, 130, 246, 0.14)"
    },
    "chart": {
      "categorical": [
        "#F47920",
        "#FFB066",
        "#8AB4F8",
        "#3FB950",
        "#C792EA",
        "#56D4DD",
        "#E5484D",
        "#F5A623"
      ],
      "sequential": [
        "#3A1E08",
        "#7A3D10",
        "#BF5613",
        "#F47920",
        "#FFB066",
        "#FFD1A6"
      ],
      "grid": "#2A2A2A",
      "axis": "#7A7A7A",
      "tooltipBg": "#222222"
    }
  },
  "font": {
    "family": {
      "sans": "'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif",
      "mono": "'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace"
    },
    "size": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "24px",
      "2xl": "32px",
      "kpi": "40px"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.7
    }
  },
  "space": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px"
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.4)",
    "md": "0 4px 12px rgba(0, 0, 0, 0.5)",
    "lg": "0 12px 32px rgba(0, 0, 0, 0.6)"
  },
  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  }
}
