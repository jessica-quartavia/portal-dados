# ── Supabase Auth (Business Data: rckpuebaiswrxzmywllv) ─────────────────────
# Usado para login Google e sessão do portal.
# Prefixo PUBLIC_ necessário para expor ao browser (ilhas React client-side).
# Na Vercel: cadastre estas duas como Environment Variables (Production + Preview)
# e faça Redeploy — o build precisa enxergá-las.
PUBLIC_AUTH_SUPABASE_URL=https://rckpuebaiswrxzmywllv.supabase.co
PUBLIC_AUTH_SUPABASE_ANON_KEY=your-business-data-anon-key
PUBLIC_SITE_URL=https://seu-projeto.vercel.app

# ── Supabase Pharus (qvtqufdivpbmubooawdm) ──────────────────────────────────
# Usado apenas para dados do dashboard Pharus (core.user_progress + realtime).
# NÃO usar para autenticação.
PUBLIC_PHARUS_SUPABASE_URL=https://qvtqufdivpbmubooawdm.supabase.co
PUBLIC_PHARUS_SUPABASE_ANON_KEY=your-pharus-anon-key

# ── Postgres direto (IAP Maio 26) ───────────────────────────────────────────
# Usado apenas nas API routes server-side. Nunca exponha esta URL no browser.
DATABASE_URL=postgresql://user:password@host:port/database

# ── Supabase Produtos ───────────────────────────────────────────────────────
PUBLIC_PRODUTOS_SUPABASE_URL=https://lacinxsvjdwalkchxyeo.supabase.co
PUBLIC_PRODUTOS_SUPABASE_ANON_KEY=your-produtos-anon-key

# ── Configuração Supabase Auth (Google OAuth) ────────────────────────────────
# No painel do projeto Business Data (rckpuebaiswrxzmywllv):
#   Authentication → Providers → Google → habilitar + inserir Client ID e Secret
#   Authentication → URL Configuration:
#     Site URL:      http://localhost:4321
#     Redirect URLs: http://localhost:4321/auth/callback
#                    https://seu-projeto.vercel.app/auth/callback
#                    https://*.vercel.app/auth/callback  (previews, se usados)
#
# O login usa o origin atual (window.location.origin), não PUBLIC_SITE_URL.
# PUBLIC_SITE_URL permanece como referência do domínio de produção na Vercel.
#
# ── Research Center (opcional) ──────────────────────────────────────────────
# Se definido, /api/research-center busca este upstream; senão usa snapshot local.
# RESEARCH_CENTER_API_URL=https://seu-upstream/api/research-center
